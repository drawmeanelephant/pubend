#!/bin/sh
set -eu

LC_ALL=C
export LC_ALL=C

fail() {
  printf '%s\n' "pubend: $1" >&2
  exit 3
}

script=$0
case $script in
  */*) ;;
  *)
    resolved=$(command -v "$script" 2>/dev/null) || resolved=
    [ -n "$resolved" ] || fail "cannot resolve executable path"
    script=$resolved
    ;;
esac

depth=0
while [ -L "$script" ]; do
  depth=$((depth + 1))
  [ "$depth" -le 40 ] || fail "too many symlinks resolving executable path"
  link=$(readlink "$script" 2>/dev/null) || fail "cannot read symlink: $script"
  case $link in
    /*)
      script=$link
      ;;
    *)
      dir=$(CDPATH='' cd -P "$(dirname "$script")" 2>/dev/null && pwd -P) || fail "cannot resolve symlink directory: $script"
      script=$dir/$link
      ;;
  esac
done

repo=$(CDPATH='' cd -P "$(dirname "$script")" 2>/dev/null && pwd -P) || fail "cannot resolve executable directory: $script"
[ -f "$repo/host/hostmain.bend" ] || fail "cannot find native host entrypoint: $repo/host/hostmain.bend"

if [ -n "${BEND_BIN:-}" ]; then
  bend_bin=$BEND_BIN
elif [ -n "${HOME:-}" ]; then
  bend_bin=$HOME/.bend/bin/bend
else
  fail "Bend 2.0.40 toolchain location is unknown because HOME is unset; install with: sh engine/tools/install_bend_ci.sh"
fi

if [ ! -x "$bend_bin" ]; then
  fail "Bend 2.0.40 toolchain is missing or not executable at $bend_bin; install it with: sh engine/tools/install_bend_ci.sh (or set BEND_BIN to a pinned Bend 2.0.40 executable)"
fi

bend_version=$("$bend_bin" version 2>&1) || fail "could not execute Bend toolchain at $bend_bin; install Bend 2.0.40 with: sh engine/tools/install_bend_ci.sh"
if [ "$bend_version" != "bend 2.0.40" ]; then
  fail "unsupported Bend toolchain at $bend_bin (expected exactly 'bend 2.0.40', got '$bend_version'); install it with: sh engine/tools/install_bend_ci.sh"
fi

bend_bin_dir=$(CDPATH='' cd -P "$(dirname "$bend_bin")" 2>/dev/null && pwd -P) || fail "cannot resolve Bend toolchain directory: $bend_bin"
bend_home=$(CDPATH='' cd -P "$bend_bin_dir/.." 2>/dev/null && pwd -P) || fail "cannot resolve Bend toolchain root from: $bend_bin"
bend_base_file=$bend_home/bend2/base.bend
bend_effs_dir=$bend_home/bend2/effs

cache_dir=$repo/.pubend-cache
mkdir -p "$cache_dir" 2>/dev/null || fail "cannot create native host cache directory: $cache_dir"

hash_manifest=
hash_material=
build_tmp=
build_log=
compiler_pid=
lock_owned=0

cleanup_build() {
  if [ -n "$hash_manifest" ]; then
    rm -f "$hash_manifest" 2>/dev/null || true
  fi
  if [ -n "$hash_material" ]; then
    rm -f "$hash_material" 2>/dev/null || true
  fi
  if [ "$lock_owned" = 1 ]; then
    if [ -n "$compiler_pid" ] && kill -0 "$compiler_pid" 2>/dev/null; then
      return 0
    fi
    if [ -n "$build_tmp" ]; then
      rm -f "$build_tmp" 2>/dev/null || true
    fi
    if [ -n "$build_log" ]; then
      rm -f "$build_log" 2>/dev/null || true
    fi
    if [ -n "${lock:-}" ]; then
      rm -f "$lock/pid" "$lock/owner" 2>/dev/null || true
      rmdir "$lock" 2>/dev/null || true
    fi
  fi
}
trap cleanup_build 0

hash_stream() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256
  else
    return 127
  fi
}

print_repo_input_files() {
  for file in host/*.bend host/host_eff.c host/host_eff.js src/*.bend; do
    [ -f "$file" ] || exit 3
    printf '%s\n' "$file"
  done
  [ -d engine/src ] || exit 3
  find engine/src -type f -name '*.bend' -print >/dev/null 2>&1 || exit 3
  find engine/src -type f -name '*.bend' -print | sort
}

print_toolchain_input_files() {
  [ -f "$bend_base_file" ] || exit 3
  printf '%s\n' "$bend_base_file"
  [ -d "$bend_effs_dir" ] || exit 3
  find "$bend_effs_dir" -type f \( -name '*.c' -o -name '*.js' \) -print >/dev/null 2>&1 || exit 3
  find "$bend_effs_dir" -type f \( -name '*.c' -o -name '*.js' \) -print | sort
}

write_hash_input_manifest() {
  (
    cd "$repo" || exit 3
    print_repo_input_files
    print_toolchain_input_files
  ) >"$hash_manifest"
}

write_hash_material() {
  (
    cd "$repo" || exit 3
    printf '%s\n' 'format=pubend-host-cache-v2'
    printf 'os=%s\n' "$(uname -s 2>/dev/null || printf '%s' unknown)"
    printf 'arch=%s\n' "$(uname -m 2>/dev/null || printf '%s' unknown)"
    printf 'bend-version=%s\n' "$bend_version"
    printf 'bend-base=%s\n' "$bend_base_file"
    printf 'bend-effs=%s\n' "$bend_effs_dir"
    while IFS= read -r file; do
      if [ ! -f "$file" ] || [ ! -r "$file" ]; then
        printf '%s\n' "pubend: native host hash input is missing or unreadable: $file" >&2
        exit 3
      fi
      byte_count=$(wc -c < "$file") || exit 3
      printf 'file=%s bytes=%s\n' "$file" "$byte_count"
      cat "$file" || exit 3
      printf '\nend-file=%s\n' "$file"
    done <"$hash_manifest"
  ) >"$hash_material"
}

host_input_hash() {
  write_hash_input_manifest || return 3
  write_hash_material || return 3
  hash_stream <"$hash_material"
}

[ -f "$bend_base_file" ] || fail "cannot hash native host inputs because the Bend base library is missing: $bend_base_file"
[ -d "$bend_effs_dir" ] || fail "cannot hash native host inputs because the Bend effs directory is missing: $bend_effs_dir"

hash_tmp_root=${TMPDIR:-/tmp}
hash_manifest=$(mktemp "$hash_tmp_root/pubend-hash-inputs.XXXXXX") || fail "cannot create native host hash input manifest temporary file"
hash_material=$(mktemp "$hash_tmp_root/pubend-hash-material.XXXXXX") || fail "cannot create native host hash material temporary file"
if ! hash_output=$(host_input_hash); then
  fail "cannot hash native host inputs; install a SHA-256 utility (sha256sum or shasum) and check that host/, src/, engine/src, and the Bend 2.0.40 base library are readable"
fi
rm -f "$hash_manifest" "$hash_material" 2>/dev/null || fail "cannot remove native host hash temporary files"
hash_manifest=
hash_material=

first_output_word() {
  set -- $1
  printf '%s' "${1:-}"
}

host_hash=$(first_output_word "$hash_output")
if [ "${#host_hash}" -ne 64 ]; then
  fail "cannot parse native host input hash from SHA-256 utility output: $hash_output"
fi
case $host_hash in
  *[!0-9a-f]*)
    fail "native host input hash is not lowercase hexadecimal: $host_hash"
    ;;
esac

target=$cache_dir/pubend-host-$host_hash
lock=$cache_dir/pubend-host-$host_hash.lock

cache_target_exists() {
  [ -e "$target" ] || [ -L "$target" ]
}

cache_target_ready() {
  [ -f "$target" ] && [ -x "$target" ] && [ ! -L "$target" ]
}

binary_magic_hex() {
  dd if="$1" bs=4 count=1 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n'
}

binary_structure_valid() {
  magic=$(binary_magic_hex "$1")
  case $(uname -s 2>/dev/null || printf '%s' unknown) in
    Darwin)
      case $magic in
        cffaedfe|cefaedfe)
          return 0
          ;;
      esac
      ;;
    Linux)
      case $magic in
        7f454c46)
          return 0
          ;;
      esac
      ;;
    *)
      case $magic in
        cffaedfe|cefaedfe|7f454c46)
          return 0
          ;;
      esac
      ;;
  esac
  return 1
}

validate_cache_target() {
  if ! cache_target_ready || ! binary_structure_valid "$target"; then
    fail "cached native host binary is corrupt or structurally invalid: $target; remove $cache_dir and retry"
  fi
}

build_abort() {
  printf '%s\n' "pubend: $1" >&2
  if [ -n "$build_log" ] && [ -f "$build_log" ]; then
    printf '%s\n' "pubend: compiler output follows" >&2
    cat "$build_log" >&2 || true
  fi
  exit 3
}

clear_stale_build_artifacts() {
  for artifact in "$cache_dir"/.building-$host_hash.*; do
    if [ -e "$artifact" ] || [ -L "$artifact" ]; then
      rm -f "$artifact" 2>/dev/null || build_abort "cannot remove stale native host build artifact: $artifact"
    fi
  done
}

build_native_host() {
  build_tmp=$cache_dir/.building-$host_hash.$$
  build_log=$cache_dir/.building-$host_hash.$$.log
  compiler_pid=
  rm -f "$build_tmp" "$build_log" 2>/dev/null || true
  clear_stale_build_artifacts

  printf '%s\n' $$ >"$lock/owner" || build_abort "cannot write native host build lock owner: $lock/owner"
  build_repo=$repo \
  build_bend_bin=$bend_bin \
  build_output=$build_tmp \
  BEND_NO_TELEMETRY=1 \
  /bin/sh -c '
    cd "$build_repo" || exit 3
    exec "$build_bend_bin" host/hostmain.bend -o "$build_output"
  ' >"$build_log" 2>&1 &
  compiler_pid=$!
  printf '%s\n' "$compiler_pid" >"$lock/pid" || build_abort "cannot write native host build lock compiler pid: $lock/pid"

  if wait "$compiler_pid"; then
    compiler_pid=
    [ -f "$build_tmp" ] || build_abort "Bend completed but did not write the native host binary: $build_tmp"
    [ -x "$build_tmp" ] || build_abort "Bend wrote a non-executable native host binary: $build_tmp"
    binary_structure_valid "$build_tmp" || build_abort "Bend wrote a structurally invalid native host binary: $build_tmp"
    if cache_target_exists; then
      rm -f "$build_tmp" 2>/dev/null || true
    else
      mv "$build_tmp" "$target" 2>/dev/null || build_abort "cannot install native host binary into cache: $target"
    fi
    rm -f "$build_log" 2>/dev/null || true
    build_tmp=
    build_log=
  else
    compiler_pid=
    build_abort "native host build failed with pinned Bend 2.0.40; command: $bend_bin host/hostmain.bend -o $build_tmp"
  fi
}

lock_pid_is_builder() {
  command_line=$(ps -p "$1" -o args= 2>/dev/null) || return 1
  case $command_line in
    *"host/hostmain.bend -o $cache_dir/.building-$host_hash."*)
      return 0
      ;;
  esac
  return 1
}

remove_waited_build_lock() {
  expected_pid=$1
  expected_owner=$2
  current_pid=$(cat "$lock/pid" 2>/dev/null || true)
  current_owner=$(cat "$lock/owner" 2>/dev/null || true)
  if [ "$current_pid" != "$expected_pid" ] || [ "$current_owner" != "$expected_owner" ]; then
    return 0
  fi
  stale_lock=$cache_dir/.stale-lock-$host_hash.$$
  if mv "$lock" "$stale_lock" 2>/dev/null; then
    rm -f "$stale_lock/pid" "$stale_lock/owner" 2>/dev/null || true
    rmdir "$stale_lock" 2>/dev/null || true
  fi
}

wait_for_build_lock() {
  waited=0
  while [ -d "$lock" ] && ! cache_target_exists; do
    lock_pid=$(cat "$lock/pid" 2>/dev/null || true)
    owner_pid=$(cat "$lock/owner" 2>/dev/null || true)
    owner_alive=0
    if [ -n "$owner_pid" ] && kill -0 "$owner_pid" 2>/dev/null; then
      owner_alive=1
    fi

    compiler_alive=0
    compiler_foreign=0
    compiler_dead=0
    if [ -n "$lock_pid" ]; then
      if kill -0 "$lock_pid" 2>/dev/null; then
        if lock_pid_is_builder "$lock_pid"; then
          compiler_alive=1
        else
          compiler_foreign=1
        fi
      else
        compiler_dead=1
      fi
    fi

    if [ "$compiler_alive" = 0 ] && [ "$owner_alive" = 0 ]; then
      remove_stale_lock=0
      if [ "$compiler_dead" = 1 ]; then
        remove_stale_lock=1
      fi
      if [ "$compiler_foreign" = 1 ] && [ "$waited" -ge 5 ]; then
        remove_stale_lock=1
      fi
      if [ -z "$lock_pid" ] && { [ -n "$owner_pid" ] || [ "$waited" -ge 5 ]; }; then
        remove_stale_lock=1
      fi
      if [ "$remove_stale_lock" = 1 ]; then
        remove_waited_build_lock "$lock_pid" "$owner_pid"
        return 0
      fi
    fi

    if [ "$waited" -ge 240 ]; then
      fail "timed out waiting for native host build lock owned by pid ${owner_pid:-unknown}: $lock"
    fi
    sleep 1
    waited=$((waited + 1))
  done
}

if cache_target_exists; then
  validate_cache_target
else
  attempts=0
  while ! cache_target_exists; do
    attempts=$((attempts + 1))
    [ "$attempts" -le 3 ] || fail "native host build did not produce a cached binary after $attempts attempts: $target"
    if mkdir "$lock" 2>/dev/null; then
      lock_owned=1
      build_native_host
      rm -f "$lock/pid" "$lock/owner" 2>/dev/null || true
      if ! rmdir "$lock" 2>/dev/null; then
        fail "cannot release native host build lock: $lock"
      fi
      lock_owned=0
    else
      wait_for_build_lock
    fi
  done
  validate_cache_target
fi

exec "$target" "$@"
